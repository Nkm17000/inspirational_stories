# MongoDB
MONGODB_URI=

# Optional story selector; leave empty to process the next PENDING story
STORY_ID=

# Cloudflare Workers AI image generation
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_STEPS=1
CLOUDFLARE_IMAGE_RETRIES=2
CLOUDFLARE_IMAGE_TIMEOUT=120

# Local neuron-routing ledger
CLOUDFLARE_DAILY_NEURON_LIMIT=10000
CLOUDFLARE_POLLINATIONS_THRESHOLD=200
CLOUDFLARE_DAILY_USAGE_DIR=logs
CLOUDFLARE_BASE_NEURONS_PER_TILE=4.8
CLOUDFLARE_NEURONS_PER_STEP=9.6

# Pollinations fallback
POLLINATIONS_IMAGE_RETRIES=3
POLLINATIONS_IMAGE_TIMEOUT=30

# Facebook Page
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v24.0
FB_VIDEO_PATH=final_video.mp4
FB_POST_TITLE=Smart Learning Lab - New Story
FB_POST_DESCRIPTION=Watch this inspiring story from Smart Learning Lab.

# Instagram Professional Account
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v23.0

# Social publisher
SOCIAL_VIDEO_PATH=final_video.mp4
STORY_TITLE=Smart Learning Lab - New Story

# Video / branding
CTA_URL=https://www.facebook.com/thesmartlearninglab
LOGO_PATH=logo.png
LOGO_SIZE=125
LOGO_MARGIN=18
END_CARD_DURATION=5
TITLE_CARD_DURATION=2
TITLE_TEMPLATE_PATH=assets/title_page_template.png
